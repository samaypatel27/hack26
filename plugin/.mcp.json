{
  "mcpServers": {
    "breakpoint": {
      "command": "python",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/server.py"],
      "env": {
        "API_URL": "${API_URL:-}",
        "API_KEY": "${API_KEY:-}",
        "AGENT_NAME": "${AGENT_NAME:-agent}",
        "BREAKPOINT_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}"
      }
    }
  }
}
