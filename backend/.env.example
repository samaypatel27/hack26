# Copy to backend/.env and fill in. Never commit the real .env.

# Supabase Postgres (Dashboard > Connect > Session pooler)
DATABASE_URL=

# Shared key for every write route (X-API-Key header). Use the same value as the plugin's api_key.
# Empty means every POST answers 401.
API_KEY=

# Claude: the specialist team, the post quality check and linking's AI check (Stage 4).
ANTHROPIC_API_KEY=
# OpenAI (optional): linking's meaning search (Stage 3) and the team's community seat. Without it,
# Stage 3 is off and that seat uses Claude.
OPENAI_API_KEY=

# Email (backend/mailer.py). Without RESEND_API_KEY, emails are only written to the log.
RESEND_API_KEY=
# Sender, e.g. Breakpoint <noreply@your-verified-domain>. Empty: Resend's test sender
# (onboarding@resend.dev), which may only deliver to the Resend account owner.
EMAIL_FROM=
# "log" or "resend". Empty: "resend" if RESEND_API_KEY is set, else "log".
EMAIL_PROVIDER=

# The website's address, used for links in emails and allowed by CORS. Default http://localhost:3000.
WEBSITE_URL=
# Websites allowed to call the API from a browser, comma-separated. Empty: http://localhost:3000.
# WEBSITE_URL is always added. Example: http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=
