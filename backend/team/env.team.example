# Specialist team settings. Copy the lines you need into backend/.env (never commit real keys).
# (This file is named env.team.example, not .env.team.example, because .gitignore ignores .env.*)

# Claude: gate (Haiku 5.5), docs + issues researchers (Sonnet 5.5), chair (Opus 5.5).
ANTHROPIC_API_KEY=
# OpenAI: community researcher (gpt-6.1-sol). Optional: without it that seat runs on Claude Sonnet 5.5.
OPENAI_API_KEY=

# Kill switch: 0 turns the team off (POST /api/help then answers TRY_FIRST).
TEAM_ENABLED=1
# Team runs per UTC day, everyone together.
TEAM_DAILY_RUNS=50
# A run stops spending once it reaches this many dollars.
TEAM_RUN_COST_CAP_USD=1.50

# Timing (seconds). Optional; these are the defaults.
# TEAM_TARGET_S=60
# TEAM_HARD_STOP_S=120
# TEAM_RESEARCHER_TIMEOUT_S=60
# TEAM_GATE_TIMEOUT_S=3.0
# TEAM_GATE_SEARCH_TIMEOUT_S=2.0
# TEAM_MAX_CONCURRENT_RUNS=4

# Tuning. Optional; these are the defaults.
# TEAM_RESEARCHER_EFFORT=low
# TEAM_CHAIR_EFFORT=high
# TEAM_SEARCH_MAX_USES=4
# TEAM_FETCH_MAX_USES=3
# TEAM_MIN_CONFIDENCE=0.4
# TEAM_STORE=memory      # force the in-memory store even when DATABASE_URL is set
